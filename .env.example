# Copy to .env and fill in real values. Never commit .env.
# Only VITE_-prefixed variables reach the browser — and everything here IS public,
# so never put a secret in this file.

# Base URL of the Podium API, including /api/v1.
VITE_API_URL=http://localhost:5000/api/v1

# Map tiles. Leaflet draws the map; these tiles are the only part that could ever cost
# money, which is why the URL lives here — swapping OpenStreetMap for Stadia, MapTiler or
# Thunderforest is a one-line change.
# Not Google Maps: it needs a billing account and its terms forbid caching tiles.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Google OAuth client id for the sign-in button. Must be one of the ids the server accepts
# in GOOGLE_CLIENT_IDS, or every sign-in is rejected.
VITE_GOOGLE_CLIENT_ID=
